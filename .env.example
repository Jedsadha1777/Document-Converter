# Ollama config
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_CORRECT=qwen2.5:1.5b
OLLAMA_MODEL_TRANSLATE=qwen2.5:1.5b

# Batch translation — ใส่ 0 ใน UI = แปลทั้งไฟล์ใน 1 call
TRANSLATE_BATCH_SIZE=5
TRANSLATE_BATCH_TIMEOUT=120
# context window สำหรับ batch — เพิ่มถ้า batch ใหญ่ + ข้อความยาว
TRANSLATE_BATCH_NUM_CTX=8192

# Gemini config (engine=gemini ใน UI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=120
# หน่วงระหว่าง Gemini batch call เป็น ms — กัน quota หมดบน free tier
# Free tier: 5 RPM → 12000ms ปลอดภัย, ตั้ง 0 ถ้า paid tier
GEMINI_BATCH_DELAY_MS=12000
