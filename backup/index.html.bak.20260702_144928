<!-- Preview prompt modal template — cloned once by preview-prompt.js on first open -->
<template id="previewModalTpl">
<div class="modal-backdrop">
    <div class="modal-card preview" role="dialog">
        <h2><span class="material-symbols-outlined">search</span>Preview prompt — payload that will be sent to the LLM</h2>
        <div class="preview-meta" id="previewMeta"></div>
        <div class="preview-bar warning">
            <label>chunk size:<input type="number" id="previewChunkSize" min="1" style="width:80px;"></label>
            <span class="dot">·</span>
            <label>chunk
                <input type="number" id="previewChunkIdx" min="1" style="width:70px;">
                <span class="total">/ <span id="previewChunkTotal">?</span></span>
            </label>
            <button type="button" id="previewPrevBtn" class="ghost"><span class="material-symbols-outlined">chevron_left</span></button>
            <button type="button" id="previewNextBtn" class="ghost"><span class="material-symbols-outlined">chevron_right</span></button>
            <button type="button" id="previewRefreshBtn" class="ghost"><span class="material-symbols-outlined">refresh</span>Reload</button>
            <span class="note" id="previewRangeNote"></span>
            <span class="status" id="previewRefreshStatus"></span>
        </div>
        <div class="preview-bar error">
            <strong>retry fail:</strong>
            <span id="previewFailedNote">— No failed rows yet</span>
            <button type="button" id="previewLoadFailedBtn" class="ghost" disabled><span class="material-symbols-outlined">place</span>Load all retry-fail rows</button>
            <span id="previewFailedMode" class="mode"></span>
        </div>
        <div class="preview-copy-row">
            <button type="button" id="previewCopyAllBtn" class="ghost" title="Copy system + user prompt as plain text (real newlines) — paste into Gemini/ChatGPT/Claude web UI"><span class="material-symbols-outlined">content_copy</span>Copy prompt (for paste)</button>
        </div>
        <h3 class="preview-h3"><span class="material-symbols-outlined">outbox</span>RAW REQUEST BODY sent to LLM API</h3>
        <div class="preview-endpoint" id="previewEndpoint"></div>
        <pre class="preview-pre body" id="previewBody"></pre>
        <h3 class="preview-h3" style="display:none;">CHARACTERS array (raw JSON)</h3>
        <pre class="preview-pre chars" id="previewChars" style="display:none;"></pre>
        <h3 class="preview-h3" style="display:none;">SYSTEM PROMPT (readable)</h3>
        <pre class="preview-pre system" id="previewSystem" style="display:none;"></pre>
        <h3 class="preview-h3" style="display:none;">USER MESSAGE (readable)</h3>
        <pre class="preview-pre user" id="previewUser" style="display:none;"></pre>
        <h3 class="preview-h3"><span class="material-symbols-outlined">content_paste_go</span>Paste LLM response (manual apply)</h3>
        <div class="preview-hint">Copy the request body above → paste into Gemini/ChatGPT/Claude web UI → copy the response back here → click "Apply to table". Markdown fences (```json ... ```) are supported.</div>
        <textarea id="previewManualResponse" class="preview-manual" rows="6" placeholder='{"items":[{"id":1,"text":"..."}, {"id":2,"text":"..."}]}'></textarea>
        <div class="preview-apply-row">
            <button type="button" id="previewApplyManualBtn">Apply to table</button>
            <span id="previewManualStatus" class="preview-status"></span>
        </div>
        <div id="previewQaRetry" style="display:none;">
            <h3 class="preview-h3"><span class="material-symbols-outlined">rule</span>QA check failed — paste this follow-up into the SAME LLM chat</h3>
            <div class="preview-hint">The original prompt (persona / TM rules / glossary) is still in that chat's context. Paste this message, copy the new response, then apply it here again.</div>
            <textarea id="previewQaRetryText" class="preview-manual" rows="5" readonly></textarea>
            <div class="preview-apply-row">
                <button type="button" id="previewQaRetryCopyBtn">Copy retry message</button>
            </div>
        </div>
        <div class="modal-foot">
            <span class="preview-foot-note">This is the actual payload the backend will send to the LLM API when you click translate.</span>
            <button type="button" id="previewCloseBtn">Close</button>
        </div>
    </div>
</div>
</template>

<script type="module">
// ── module imports — modules อื่นๆ self-contained (wire ปุ่มเองตอน load), ที่นี่แค่ wiring ──
import { state } from "/static/js/state.js";
import { initCharactersUI } from "/static/js/characters.js";
import { setStatus, clearStatus } from "/static/js/status.js";
import { initCompare, buildCompareTable } from "/static/js/compare.js";
import { initUpload } from "/static/js/upload.js";
import { initPasteText } from "/static/js/paste-text.js";
import { initDetectRowMeta } from "/static/js/detect-row-meta.js";
import { initSubTm } from "/static/js/sub-tm.js";
import { renderPreview, redrawOnly, setupEditMode, clearSelectionAndUI, exportCurrentPageImage, exportAllPagesImages } from "/static/js/preview.js";
import { renderBeforePane } from "/static/js/visual/before-pane.js";
import { renderThumbSidebar, setActiveThumb } from "/static/js/visual/thumbnail.js";
import { initPanZoom } from "/static/js/visual/pan-zoom.js";
import { initToolButtons, getTool } from "/static/js/visual/tool-mode.js";
import { initLayerButtons } from "/static/js/visual/layer-mode.js";
import { initInspector, updateInspector } from "/static/js/visual/inspector.js";
import * as viewport from "/static/js/visual/viewport.js";
// side-effect imports — wire toolbar buttons (run/stop/clear/retry/preview/copy/paste/tm)
import "/static/js/correct-runner.js";
import "/static/js/translate-runner.js";
import "/static/js/preview-prompt.js";
import "/static/js/tm.js";

// expose state + viewport บน window สำหรับ test + dev debug
window.state = state;
window.viewport = viewport;

// initPanZoom + tool buttons (select / pan)
initPanZoom(document.getElementById("splitMain"), {
    shouldPan: (e) => e.button === 0 && getTool() === "pan",
});
initToolButtons();
initLayerButtons();
initInspector();

const rulesModal = document.getElementById("rulesModal");
document.getElementById("rulesBtn").addEventListener("click", () => rulesModal.classList.add("show"));
document.getElementById("rulesCloseBtn").addEventListener("click", () => rulesModal.classList.remove("show"));
rulesModal.addEventListener("click", (e) => { if (e.target === rulesModal) rulesModal.classList.remove("show"); });

const splitMainEl = document.getElementById("splitMain");
const splitDivider = document.getElementById("splitDivider");
splitDivider.addEventListener("mousedown", (e) => {
    e.preventDefault();
    e.stopPropagation();
    splitDivider.classList.add("dragging");
    document.body.style.cursor = "col-resize";
    const onMove = (ev) => {
        const r = splitMainEl.getBoundingClientRect();
        const pct = Math.min(80, Math.max(20, ((ev.clientX - r.left) / r.width) * 100));
        splitMainEl.style.gridTemplateColumns = `${pct}% 6px 1fr`;
    };
    const onUp = () => {
        document.removeEventListener("mousemove", onMove);
        document.removeEventListener("mouseup", onUp);
        splitDivider.classList.remove("dragging");
        document.body.style.cursor = "";
        window.dispatchEvent(new Event("resize"));
    };
    document.addEventListener("mousemove", onMove);
    document.addEventListener("mouseup", onUp);
});

// ── Zoom toolbar (fit / 100% / zoom +/-) + indicator ───────────────────
const zoomLevelEl = document.getElementById("zoomLevel");
function _fitCurrentPage() {
    const pane = document.getElementById("previewArea");
    if (!pane) return;
    const r = pane.getBoundingClientRect();
    const p = state.lastResult?.preview?.pages?.[0];
    if (!p) return;
    const w = p.img_width || p.width || 1;
    const h = p.img_height || p.height || 1;
    viewport.fitToViewport(w, h, r.width, r.height);
}
function _zoomAtCenter(factor) {
    const sm = document.getElementById("splitMain");
    const r = sm.getBoundingClientRect();
    viewport.zoomAt(r.width / 2, r.height / 2, factor);
}
document.getElementById("zoomInBtn")?.addEventListener("click", () => _zoomAtCenter(1.25));
document.getElementById("zoomOutBtn")?.addEventListener("click", () => _zoomAtCenter(0.8));
document.getElementById("zoom100Btn")?.addEventListener("click", () => {
    // 1:1 image-pixel : screen-pixel, center on viewport
    const sm = document.getElementById("splitMain");
    const r = sm.getBoundingClientRect();
    const cur = viewport.getZoom() || 1;
    viewport.zoomAt(r.width / 2, r.height / 2, 1 / cur);
});
zoomLevelEl?.addEventListener("click", _fitCurrentPage);
viewport.onChange((s) => {
    if (zoomLevelEl) zoomLevelEl.textContent = Math.round(s.zoom * 100) + "%";
});

document.getElementById("exportImageBtn")?.addEventListener("click", exportCurrentPageImage);
document.getElementById("exportAllImagesBtn")?.addEventListener("click", exportAllPagesImages);

// ── Preview mode (fullscreen, ไม่มี chrome / border / thumbnail / menu) ───────
// scroll = page nav, arrow keys = page nav, ESC / ปุ่ม preview อีกครั้ง = exit
const previewModeBtn = document.getElementById("previewModeBtn");

function _changePageDelta(delta) {
    const sel = document.getElementById("pageSelect");
    if (!sel || !sel.options.length) return;
    const opts = Array.from(sel.options);
    const idx = opts.findIndex(o => o.value === sel.value);
    const newIdx = Math.max(0, Math.min(opts.length - 1, idx + delta));
    if (newIdx === idx) return;
    sel.value = opts[newIdx].value;
    sel.dispatchEvent(new Event("change"));
    renderBeforePane();
    setActiveThumb(parseInt(sel.value, 10));
}
function _setPreviewBtnIcon(active) {
    const icon = previewModeBtn?.querySelector(".material-symbols-outlined");
    if (icon) icon.textContent = active ? "fullscreen_exit" : "fullscreen";
}
function _enterPreviewMode() {
    if (state.previewMode) return;
    state.previewMode = true;
    redrawOnly();
    document.body.classList.add("preview-mode");
    _setPreviewBtnIcon(true);
    requestAnimationFrame(_fitCurrentPage);
}
function _exitPreviewMode() {
    if (!state.previewMode) return;
    state.previewMode = false;
    document.body.classList.remove("preview-mode");
    _setPreviewBtnIcon(false);
    redrawOnly();
    requestAnimationFrame(_fitCurrentPage);
}
previewModeBtn?.addEventListener("click", () => {
    state.previewMode ? _exitPreviewMode() : _enterPreviewMode();
});
// keyboard — ESC = exit, arrow = page nav (เฉพาะ preview mode, กัน input/textarea focus)
document.addEventListener("keydown", (e) => {
    if (!state.previewMode) return;
    const tag = (document.activeElement?.tagName || "").toLowerCase();
    if (tag === "input" || tag === "textarea" || tag === "select") return;
    if (e.key === "Escape") { _exitPreviewMode(); e.preventDefault(); return; }
    if (e.key === "ArrowLeft" || e.key === "ArrowUp" || e.key === "PageUp") {
        _changePageDelta(-1); e.preventDefault();
    } else if (e.key === "ArrowRight" || e.key === "ArrowDown" || e.key === "PageDown") {
        _changePageDelta(1); e.preventDefault();
    }
});
// wheel — plain wheel = page nav ใน preview mode (capture phase → กัน pan-zoom.js)
// ctrl/cmd+wheel ยังเป็น zoom (ปล่อย pan-zoom รับเองตาม bubble)
let _wheelLockAt = 0;
document.addEventListener("wheel", (e) => {
    if (!state.previewMode) return;
    if (e.ctrlKey || e.metaKey) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    const now = performance.now();
    if (now - _wheelLockAt < 180) return;   // debounce — wheel ส่ง event ถี่
    _wheelLockAt = now;
    _changePageDelta(e.deltaY > 0 ? 1 : -1);
}, { capture: true, passive: false });

// thumbnail click → switch page
window._onThumbClickPage = function(pageNo) {
    const pageSelect = document.getElementById("pageSelect");
    if (!pageSelect) return;
    pageSelect.value = String(pageNo);
    viewport.clearTargets();
    viewport.reset();
    renderBeforePane();
    pageSelect.dispatchEvent(new Event("change"));
    setActiveThumb(pageNo);
};

// selection refs — Set by ref, mutations sync กับ state
const selectedRefs = state.selection.refs;

const output = document.getElementById("output");
const pageSelect = document.getElementById("pageSelect");
const ocrEngineSelect = document.getElementById("ocr_engine");
// mokuro มี OCR engine ของตัวเอง — ซ่อน docling OCR engine dropdown
function syncOcrEngineVisibility() {
    const hide = document.getElementById("lang").value === "manga";
    document.getElementById("ocrEngineLabel").style.display = hide ? "none" : "";
    ocrEngineSelect.style.display = hide ? "none" : "";
}
document.getElementById("lang").addEventListener("change", syncOcrEngineVisibility);
syncOcrEngineVisibility();

// ── จำค่า dropdown/checkbox ใน localStorage ──
const CONVERT_PREFS_KEY = "doclingConvertPrefs";
const langSelect = document.getElementById("lang");
const translateEngineSelectEl = document.getElementById("translateEngine");
const tmPairSelectEl = document.getElementById("tmPair");
const contentTypeSelectEl = document.getElementById("contentType");

// Type options ผูกกับ TM pair (folder name ใน data_tm/{pair}/{type}/)
const CONTENT_TYPES_BY_PAIR = {
    "jp-th": [
        { value: "manga_novel", label: "Manga / Novel" },
        { value: "tutorial",    label: "Tutorial (web manual)" },
    ],
    "en-th": [
        { value: "manga_novel", label: "Manga / Novel" },
        { value: "tutorial",    label: "Tutorial (web manual)" },
    ],
    "en-vn": [
        { value: "product_catalog", label: "Product catalog" },
    ],
};

function populateContentTypes(pair, preferredValue) {
    const opts = CONTENT_TYPES_BY_PAIR[pair] || [];
    contentTypeSelectEl.innerHTML = "";
    for (const o of opts) {
        const el = document.createElement("option");
        el.value = o.value;
        el.textContent = o.label;
        contentTypeSelectEl.appendChild(el);
    }
    if (preferredValue && opts.some(o => o.value === preferredValue)) {
        contentTypeSelectEl.value = preferredValue;
    }
}

function _setSelectIfOption(selectEl, value) {
    if (!selectEl || !value) return;
    const opt = selectEl.querySelector(`option[value="${value}"]`);
    if (opt && !opt.disabled) selectEl.value = value;
}
function _loadConvertPrefs() {
    try {
        const raw = localStorage.getItem(CONVERT_PREFS_KEY);
        const p = raw ? JSON.parse(raw) : {};
        _setSelectIfOption(langSelect, p.lang);
        _setSelectIfOption(ocrEngineSelect, p.ocr_engine);
        _setSelectIfOption(translateEngineSelectEl, p.translate_engine);
        _setSelectIfOption(tmPairSelectEl, p.tm_pair);
        // populate type AFTER tm pair restored (type list ขึ้นกับ pair)
        populateContentTypes(tmPairSelectEl.value, p.content_type);
    } catch (_) {
        populateContentTypes(tmPairSelectEl.value);
    }
}
function _saveConvertPrefs() {
    try {
        localStorage.setItem(CONVERT_PREFS_KEY, JSON.stringify({
            lang: langSelect.value,
            ocr_engine: ocrEngineSelect.value,
            translate_engine: translateEngineSelectEl?.value || null,
            tm_pair: tmPairSelectEl?.value || null,
            content_type: contentTypeSelectEl?.value || null,
        }));
    } catch (_) {}
}
_loadConvertPrefs();
syncOcrEngineVisibility();
[langSelect, ocrEngineSelect,
 translateEngineSelectEl, tmPairSelectEl, contentTypeSelectEl].forEach(el =>
    el && el.addEventListener("change", _saveConvertPrefs)
);
tmPairSelectEl.addEventListener("change", () => {
    populateContentTypes(tmPairSelectEl.value);
    _saveConvertPrefs();
});

// Compare + Visual tabs = full screen (ทิ้ง max-width 1280); Output tab keep แคบ
function _applyFullscreenForTab(name) {
    document.body.classList.toggle("app-fullscreen", name === "visual" || name === "compare");
}
document.querySelectorAll(".tab").forEach(btn => {
    btn.addEventListener("click", () => {
        document.querySelectorAll(".tab").forEach(b => b.classList.remove("active"));
        document.querySelectorAll(".tab-panel").forEach(p => p.classList.remove("active"));
        btn.classList.add("active");
        document.getElementById("panel-" + btn.dataset.tab).classList.add("active");
        _applyFullscreenForTab(btn.dataset.tab);
        if (btn.dataset.tab === "visual") {
            renderThumbSidebar(window._onThumbClickPage);
            renderBeforePane();
            renderPreview();
        }
        if (btn.dataset.tab === "compare") buildCompareTable();
    });
});
// apply on initial load — visual tab เป็น default active
_applyFullscreenForTab(document.querySelector(".tab.active")?.dataset.tab);

pageSelect.addEventListener("change", renderPreview);
pageSelect.addEventListener("change", () => { if (selectedRefs.size) clearSelectionAndUI(); });

// Copy/Download/Clear JSON output
document.getElementById("copyBtn").addEventListener("click", async () => {
    if (!output.value) return;
    await navigator.clipboard.writeText(output.value);
    setStatus("Copied", "success");
});
document.getElementById("downloadBtn").addEventListener("click", () => {
    if (!output.value) return;
    const blob = new Blob([output.value], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "docling-texts.json";
    a.click();
    URL.revokeObjectURL(url);
});
document.getElementById("clearBtn").addEventListener("click", () => {
    output.value = "";
    clearStatus();
});

// bridge — history.onChange ใน preview.js เรียก buildCompareTable หลัง undo/redo
window.buildCompareTable = buildCompareTable;

// ── boot: ส่ง config Jinja ให้ compare + wire toolbars/modals/upload ──
initCompare({
    batchSizeDefault: parseInt("{{ translate_batch_size_default }}", 10) || 5,
    geminiDelayMs: parseInt("{{ gemini_batch_delay_ms }}", 10) || 0,
    geminiModel: "{{ gemini_model or 'gemini-2.5-flash' }}",
});
setupEditMode();
initCharactersUI({
    onChange: () => {
        if (state.lastResult && document.querySelector(".tab.active").dataset.tab === "compare") {
            buildCompareTable(true);
        }
    },
});
initUpload({});
initPasteText();
initDetectRowMeta();
initSubTm();
</script>
</body>
